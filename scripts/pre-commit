#!/usr/bin/env bash
set -e

# Get only staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  exit 0
fi

echo "Running pre-commit checks..."

# Check formatting
UNFORMATTED=$(gofmt -l $STAGED_GO_FILES)
if [ -n "$UNFORMATTED" ]; then
  echo "ERROR: The following files are not formatted. Run 'gofmt -w' on them:"
  echo "$UNFORMATTED"
  exit 1
fi

# Vet
echo "  go vet..."
go vet ./...

# Lint (if available)
if command -v golangci-lint &> /dev/null; then
  echo "  golangci-lint..."
  golangci-lint run ./...
fi

# Build
echo "  go build..."
go build ./...

# Tests
#
# ./e2e is excluded deliberately. Those tests talk to the live API with a real
# account, and TestE2E_ComputeServerLifecycle provisions a billable VM. A
# developer who happens to have PIDGINHOST_API_TOKEN exported would hit the
# real API on every single commit. Run them on purpose: go test ./e2e/...
echo "  go test..."
go test $(go list ./... | grep -v /e2e)

echo "All checks passed."
